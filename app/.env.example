# Copy to .env.local (git-ignored) and fill in.
# Supabase dashboard -> Project Settings -> API (or "API Keys")

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key. Public by design: it ships to every browser,
# and Row Level Security is what protects the data.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service_role / secret key in this app. It bypasses RLS.
