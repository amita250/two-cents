# Copy to .env.local and fill in. Never commit the real file.
# Find these in Supabase: Project Settings -> API

# Public by design: safe in the browser, data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service_role key here or anywhere in the client. It bypasses RLS.
